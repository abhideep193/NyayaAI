# Copy this file to ".env" (same folder) and fill in real values.
# .env is listed in .gitignore, so your real key is never committed.

# Your OpenAI API key (starts with "sk-")
OPENAI_API_KEY=

# Which OpenAI model writes the answers. See https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-6.1-terra

# How many law sections are given to the model per question (default 15)
ANSWER_CONTEXT_SECTIONS=15
