# --- Secrets: NEVER commit these ---
# Real API keys and passwords live in .env.
# (.env.example is different: it holds placeholder names only and IS committed.)
.env

# --- Python virtual environment ---
# Rebuild it with: pip install -r requirements.txt
.venv/

# --- Files Python generates automatically ---
__pycache__/
*.pyc

# --- Test tool cache (created when we run pytest later) ---
.pytest_cache/

# --- Generated search index (rebuilt automatically) ---
# The per-area indexes (embeddings_cache.npz = IPR, embeddings_cache_criminal.npz = criminal) ARE committed,
# so the deployed app starts without computing them; they rebuild automatically if the Acts change.
data/processed/embeddings_cache_*_*.npz
